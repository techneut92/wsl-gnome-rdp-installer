#!/bin/bash
# wsl-theme-sync — mirror Windows' light/dark theme into GNOME.
#
# WSLg doesn't propagate the host's theme to Linux apps. Reads
# HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize\
# AppsUseLightTheme via reg.exe interop, sets
# org.gnome.desktop.interface.{color-scheme,gtk-theme} to match.
#
# Polls — the registry doesn't expose a Linux-watchable signal, so the
# companion .timer fires this every minute. No-op on each run unless
# the Windows value differs from what we last wrote.
#
# Runs as the user (user systemd unit). Reads + writes only this user's
# gsettings; no root, no /etc.

set -eo pipefail

# Skip silently if interop is dead — happens after `wsl --shutdown`
# and before the binfmt drop-in re-registers, or in headless containers.
command -v reg.exe   >/dev/null 2>&1 || exit 0
command -v gsettings >/dev/null 2>&1 || exit 0

val=$(reg.exe query \
        'HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize' \
        /v AppsUseLightTheme 2>/dev/null \
      | awk '/AppsUseLightTheme/{print $NF}' \
      | tr -d '\r')

case "$val" in
  0x0) want_scheme=prefer-dark;  want_gtk=Adwaita-dark ;;
  0x1) want_scheme=default;      want_gtk=Adwaita      ;;
  *)   exit 0 ;;
esac

# Only flip gsettings if a value actually changed — no signal storms,
# no journal noise on idle ticks.
cur_scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
cur_gtk=$(   gsettings get org.gnome.desktop.interface gtk-theme    2>/dev/null | tr -d "'")

[ "$cur_scheme" = "$want_scheme" ] || gsettings set org.gnome.desktop.interface color-scheme "$want_scheme"
[ "$cur_gtk"    = "$want_gtk"    ] || gsettings set org.gnome.desktop.interface gtk-theme    "$want_gtk"

# Quiet on no-op so the journal stays useful.
if [ "$cur_scheme" != "$want_scheme" ] || [ "$cur_gtk" != "$want_gtk" ]; then
  echo "wsl-theme-sync: AppsUseLightTheme=$val → color-scheme=$want_scheme gtk-theme=$want_gtk"
fi
