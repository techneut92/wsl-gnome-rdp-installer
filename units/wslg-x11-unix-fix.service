[Unit]
Description=Restore /tmp/.X11-unix to a writable mode-1777 directory (so Xwayland can start in the RDP session)
# WSLg shadows /tmp/.X11-unix on every boot in one of two layouts:
#   - legacy: a symlink to /mnt/wslg/.X11-unix
#   - newer (Ubuntu 26.04+): a read-only tmpfs (sometimes stacked twice)
#
# Mutter's Xwayland rejects both ("Directory \"/tmp/.X11-unix\" is
# missing the sticky bit" / "...is not writable"). Once Xwayland fails,
# gnome-shell-headless falls into a SIGABRT restart loop and the whole
# RDP session is dead. The helper does the layout-specific cleanup and
# re-exposes WSLg's X0 socket so DISPLAY=:0 callers keep working.
#
# Earlier revisions guarded this unit with ConditionPathIsSymbolicLink=
# /tmp/.X11-unix, which became a stealth-skip on Ubuntu 26.04 where
# the path is no longer a symlink. The helper itself is now idempotent,
# so no condition is needed.
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/wslg-x11-unix-fix

[Install]
WantedBy=multi-user.target
